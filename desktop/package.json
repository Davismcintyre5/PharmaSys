{
  "name": "pharmasys-desktop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "PharmaSys — Modern pharmacy management for Kenya and beyond.",
  "main": "electron/main.js",
  "author": {
    "name": "Davis Okoth",
    "email": "davismcintyre5@gmail.com"
  },
  "publisher": "HDM",
  "owner": "Davis Okoth",
  "company": "HDM",
  "license": "ISC",
  "scripts": {
    "dev": "vite --port 3000 --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 3000",
    "lint": "eslint . --ext ts,tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "assets": "node scripts/generate-assets.js",

    "electron:dev": "npm run assets && npm run build && electron .",
    "electron:start": "electron .",

    "electron:build": "npm run assets && npm run build && electron-builder --publish always",
    "electron:build:win": "npm run assets && npm run build && electron-builder --win --publish always",
    "electron:build:mac": "npm run assets && npm run build && electron-builder --mac --publish always",
    "electron:build:linux": "npm run assets && npm run build && electron-builder --linux --publish always",
    "electron:build:local": "npm run assets && npm run build && electron-builder --publish never",

    "release:patch": "npm version patch -m \"Release v%s\"",
    "release:minor": "npm version minor -m \"Release v%s\"",
    "release:major": "npm version major -m \"Release v%s\"",
    "release:push": "git push --follow-tags"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "axios": "^1.7.7",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "electron-updater": "^6.2.1",
    "lucide-react": "^0.451.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-hook-form": "^7.53.0",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.13.0",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
"devDependencies": {
  "@types/node": "^22.7.5",
  "@types/react": "^18.3.11",
  "@types/react-dom": "^18.3.1",
  "@typescript-eslint/eslint-plugin": "^8.8.1",
  "@typescript-eslint/parser": "^8.8.1",
  "@vitejs/plugin-react": "^4.3.2",
  "autoprefixer": "^10.4.20",
  "electron": "^43.4.0",
  "electron-builder": "^24.13.3",
  "eslint": "^9.12.0",
  "eslint-plugin-react-hooks": "^5.0.0",
  "eslint-plugin-react-refresh": "^0.4.12",
  "png-to-ico": "^2.1.8",
  "postcss": "^8.4.47",
  "prettier": "^3.3.3",
  "sharp": "^0.33.5",
  "tailwindcss": "^3.4.13",
  "typescript": "^5.6.3",
  "vite": "^5.4.8"
}
}